{
    "corpora": {
        "glowbe": {
            "root_path": "/gscratch/stf/jcmw614/data/glowbe/glowbe-text",
            "file_pattern": "*.zip"
        },
        "ice": {
            "root_path": "/gscratch/stf/jcmw614/data/ice",
            "file_pattern": "**/*.txt",
            "tag_registry": {
                "treat_as_foreign": [
                    "</?&french>",
                    "</?&german>",
                    "</?&greek>",
                    "</?&hebrew>",
                    "</?&italian>",
                    "</?&spanish>",
                    "</?ame/?>",
                    "</?foreign[=a-z]*_?/?>"
                ],
                "treat_as_indig": [
                    "</?&irish>",
                    "</?ea_?/?>",
                    "</?indig[=a-z]*/?>",
                    "<afr/>"
                ],
                "alter": {
                    "transcriber_deletion": {
                        "pat": "<-[/_](?P<original_text>[a-z'. ]+)>",
                        "sub": "\\g<original_text>"
                    },
                    "horizontal_whitespace": {
                        "pat": "[^\\S+\\r\\n]+",
                        "sub": " "
                    },
                    "name_placeholder": {
                        "pat": "</?(?P<placeholder>name[s]?)/?>/?",
                        "sub": "\\g<placeholder>"
                    }
                },
                "drop_full_span": [
                   "\\*",
                    "\\+_[a-z'.]+",
                    "\\+",
                    "&?music[=a-z]*",
                    "&",
                    "age",
                    "author-gender",
                    "date",
                    "del",
                    "delete",
                    "ethnic-group",
                    "marginalia",
                    "meta",
                    "o/?_?",
                    "onom",
                    "place",
                    "source",
                    "transcriber",
                    "unc",
                    "unclear[-a-z]*",
                    "x"
                ],
                "drop_tag_only": [
                    "<-/>",
                    "</?@[a-z]*>",
                    "<[?]xml version=[\"']\\d\\.\\d[\"']( encoding=[\"']utf-8[\"'])?[?]?>",
                    "<[#]\\\\?>",
                    "<[$][ a-z?]+\\d*>",
                    "<[$]>",
                    "<[sw]\\d[a-z][ 0-9$#x:a-z?-]+>",
                    "</?-[_ ]?>",
                    "</?[?]+/?>",
                    "</?[\\[\\]{}]\\d*>",
                    "</?[a-z]+ing[s]?>",
                    "</?[a-z]+ly>",
                    "</?\\./?>",
                    "</?\\d+>",
                    "</?&french>",
                    "</?&german>",
                    "</?&greek>",
                    "</?&hebrew>",
                    "</?&irish>",
                    "</?&italian>",
                    "</?&spanish>",
                    "</?=/?>",
                    "</?accent[=a-z]+>",
                    "</?ame/?>",
                    "</?annotated version=[\"']\\d\\.\\d[\"']>",
                    "</?annotated>",
                    "</?b>",
                    "</?bold>",
                    "</?box>",
                    "</?caps>",
                    "</?centre>",
                    "</?drawls>",
                    "</?ea_?/?>",
                    "</?emoji>",
                    "</?exhales>",
                    "</?fnr/?>",
                    "</?footnote/?>",
                    "</?foreign[=a-z]*_?/?>",
                    "</?groans>",
                    "</?h/?>",
                    "</?hashtag>",
                    "</?i>",
                    "</?imitates>",
                    "</?indent>",
                    "</?indig[=a-z]*/?>",
                    "</?it/?>",
                    "</?italics>",
                    "</?laugh[s]?[=a-z]*/?>",
                    "</?longdash/?>",
                    "</?mention/?>",
                    "</?p/?>",
                    "</?punctuation>",
                    "</?quote[s]?/?_?>",
                    "</?reads>",
                    "</?roman>",
                    "</?sb/?>",
                    "</?sent>",
                    "</?sh>",
                    "</?shouts>",
                    "</?sighs>",
                    "</?smallcaps>",
                    "</?sp/?>",
                    "</?text>",
                    "</?title/?>",
                    "</?typeface>",
                    "</?ul>",
                    "</?voice=[a-z]+>",
                    "</?w/?\\s?>",
                    "</?whispers>",
                    "</?writes[=a-z]*>",
                    "</?yawns>",
                    "</note>",
                    "</sic>",
                    "<\\s*,+\\s*>",
                    "<#\\d+:\\d+[:a-z]*>",
                    "<afr/>",
                    "<ice-[a-z]+:[sw]\\d[a-z][ 0-9#x:a-z?-]+>",
                    "<l[-\\^]?>",
                    "<meta http-equiv=[\"']content-type[\"'] content=[\"']text/html; charset=utf-8[\"'] />",
                    "<note comment=(.+)>",
                    "<number/>",
                    "<sic( corr=[\"'].*[\"'])?>",
                    "<slang/>",
                    "<space[s\\^]*>",
                    "<unintelligible>"
                ]
            }
        },
        "lince": {
            "root_path": "/gscratch/stf/jcmw614/data/lince-kaggle",
            "file_pattern": "*_*eng_*.csv"
        }
    }
}